{
  "name": "meeting-assistant",
  "version": "1.0.0",
  "description": "AI meeting and mock-interview assistant overlay",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "start:hidden": "node scripts/run-electron.js --start-hidden",
    "dev": "node scripts/run-electron.js --enable-logging",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/run-build.js",
    "build:win": "node scripts/run-build.js --win",
    "build:mac": "node scripts/run-build.js --mac",
    "build:linux": "node scripts/run-build.js --linux",
    "bench:llm": "node scripts/bench-llm.js",
    "test:live": "node scripts/test-live-pipeline.js",
    "smoke": "node scripts/run-electron.js --smoke-test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.3.1",
    "pdf-parse": "2.4.5",
    "screenshot-desktop": "^1.15.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "^0.25.6"
  },
  "build": {
    "appId": "dev.local.meeting-assistant",
    "productName": "Meeting Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!.git/**/*",
      "!dist/**/*"
    ],
    "asarUnpack": [
      "node_modules/screenshot-desktop/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Transcribes the other side of your call (system audio) for live notes and answers.",
        "NSMicrophoneUsageDescription": "Transcribes what you say for live notes and answers."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "fileAssociations": []
    },
    "portable": {
      "artifactName": "MeetingAssistant-${version}.exe"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MeetingAssistant-Setup-${version}.exe"
    }
  },
  "author": "Shubham",
  "license": "MIT"
}
