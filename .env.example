# In the app, API keys are entered in Settings and stored in app state.
# The keys below are only read by the test scripts (npm run bench:llm,
# npm run test:live) and as a fallback for the fast cloud model provider.
# Never commit your real .env.
ASSEMBLY_AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Fast cloud model used by test:live and as the provider default
# (groq | openai | cerebras | openrouter | gemini)
FAST_LLM_PRESET=groq
FAST_LLM_MODEL=

# Optional capture behavior
# true = hide this app from screen sharing/screen capture
# false = allow this app to appear in screen sharing/screen capture
HIDE_FROM_SCREEN_CAPTURE=true

# Optional startup mode
# true = start in background mode (window hidden at launch)
# false = show window on startup
START_HIDDEN=false

# Optional screenshot settings
MAX_SCREENSHOTS=50
SCREENSHOT_DELAY=1000

# Optional runtime settings
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
